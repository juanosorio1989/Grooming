DATABASE_URL=postgresql://grooming:grooming@localhost:5433/grooming
DATABASE_URL_TEST=postgresql://grooming:grooming@localhost:5433/grooming_test
REDIS_URL=redis://localhost:6380
# Integration tests FLUSHDB this one: never DB 0 or the REDIS_URL database
REDIS_URL_TEST=redis://localhost:6380/1
WEB_ORIGIN=http://localhost:3000
PORT=3001
NODE_ENV=development
# Optional: shadow database for the drift check (default: DATABASE_URL_TEST + "_shadow")
# SHADOW_DATABASE_URL=postgresql://grooming:grooming@localhost:5433/grooming_test_shadow

# Single-tenant MVP: the organization every request belongs to (seeded by db:seed)
DEFAULT_ORG_SLUG=demo-salon

# Secrets: run pnpm --filter @grooming/api secrets:gen (fills empty values in .env, prints key names only)
JWT_PRIVATE_KEY_B64=
DATA_ENCRYPTION_KEY=
# JWT_KEY_ID=k1
# DATA_ENCRYPTION_KEY_ID=k1

# Cookies / proxy (COOKIE_SECURE defaults to true only in production)
# COOKIE_SECURE=false
# COOKIE_DOMAIN=
# TRUST_PROXY: false (default) | hop count | comma-separated proxy IPs/CIDRs; use 1 on Railway/Fly.
# "true" is rejected: it would trust a client-forged X-Forwarded-For and bypass per-IP rate limits.
# TRUST_PROXY=false

# OTP: console (logs codes) | twilio (required in production) | fake (tests only)
OTP_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# Email: console | resend (required in production)
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM=Grooming <no-reply@example.com>

# Object storage (local minio). Root credentials are read by docker compose from .env; choose local-only values.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://localhost:9010
S3_REGION=auto
S3_BUCKET=pet-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
