{
  "name": "@grooming/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "dotenv -e ../../.env -- vitest run --config vitest.int.config.mts",
    "secrets:gen": "tsx scripts/gen-secrets.ts",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:drift": "dotenv -e ../../.env -- bash scripts/check-drift.sh",
    "create-owner": "nest build && dotenv -e ../../.env -- node dist/cli/create-owner.js",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@grooming/availability": "workspace:*",
    "@grooming/contracts": "workspace:*",
    "@grooming/datetime": "workspace:*",
    "@grooming/pricing": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "ioredis": "^5",
    "jose": "^5.10.0",
    "nestjs-zod": "^5.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@grooming/config": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.7.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "dotenv-cli": "^7.4.0",
    "eslint": "^9.12.0",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^2.1.0"
  }
}
